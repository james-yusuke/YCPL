module(
    name = "ycpl",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "cxx.rs", version = "1.0.205", repo_name = "cxx")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_exec_rustc_flags = ["-Cstrip=none"],
    # Keep proc-macro metadata intact with recent Apple linkers.
    extra_rustc_flags = ["-Cstrip=none"],
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "rust_crates",
    cargo_lockfile = "//bootstrap/rust:Cargo.lock",
    manifests = ["//bootstrap/rust:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "rust_crates")

llvm = use_extension("//tools/bazel:llvm_configure.bzl", "llvm_config_extension")
use_repo(llvm, "llvm_config")
