// The compiler stores temporary LLVMRef arrays in managed Vec<i64> values.
// Raw backing storage is exposed only at this FFI boundary; normal YCPL code
// has no Vec-to-pointer conversion.
pub intrinsic fn vec_data_i64(values Vec<i64>) *byte

// Opaque managed storage for arrays of foreign LLVM references. Keeping this
// allocation in c/llvm prevents compiler code from depending on std.mem or
// exposing a general Vec-to-pointer conversion.
pub fn refs(count i32) *i64 {
    if count < 0 { return none }
    data: *i64 := mem.calloc(count, 8)
    return mem.keep(data)
}

pub fn storage(count i32, element_size i32) *byte {
    if count < 0 || element_size < 0 { return none }
    return mem.keep(mem.calloc(count, element_size))
}

pub fn refs_get(values *i64, index i32) *byte {
    if values == none || index < 0 { return none }
    return cast(*byte, values[index])
}

pub fn refs_set(values *i64, index i32, value *byte) {
    if values == none || index < 0 { return }
    values[index] = cast(i64, value)
}

fn refs_data(values *i64) *byte {
    return cast(*byte, values)
}

pub fn struct_type_refs(ctx *byte, fields *i64, count i32, packed i32) *byte {
    return struct_type(ctx, refs_data(fields), count, packed)
}

pub fn set_struct_body_refs(typ *byte, fields *i64, count i32, packed i32) {
    set_struct_body(typ, refs_data(fields), count, packed)
}

pub fn function_type_refs(result *byte, params *i64, count i32, variadic i32) *byte {
    return function_type(result, refs_data(params), count, variadic)
}

pub fn build_call_refs(builder *byte, typ *byte, function *byte, args *i64, count i32, name string) *byte {
    return build_call(builder, typ, function, refs_data(args), count, name)
}

pub fn build_gep_refs(builder *byte, typ *byte, address *byte, indices *i64, count i32, name string) *byte {
    return build_gep(builder, typ, address, refs_data(indices), count, name)
}

pub fn add_incoming_refs(phi *byte, values *i64, blocks *i64, count i32) {
    add_incoming(phi, refs_data(values), refs_data(blocks), count)
}

pub fn struct_type_vec(ctx *byte, fields Vec<i64>, count i32, packed i32) *byte {
    return struct_type(ctx, vec_data_i64(fields), count, packed)
}

pub fn set_struct_body_vec(typ *byte, fields Vec<i64>, count i32, packed i32) {
    set_struct_body(typ, vec_data_i64(fields), count, packed)
}

pub fn function_type_vec(result *byte, params Vec<i64>, count i32, variadic i32) *byte {
    return function_type(result, vec_data_i64(params), count, variadic)
}

pub fn build_call_vec(builder *byte, typ *byte, function *byte, args Vec<i64>, count i32, name string) *byte {
    return build_call(builder, typ, function, vec_data_i64(args), count, name)
}

pub fn build_gep_vec(builder *byte, typ *byte, address *byte, indices Vec<i64>, count i32, name string) *byte {
    return build_gep(builder, typ, address, vec_data_i64(indices), count, name)
}

pub fn add_incoming_vec(phi *byte, values Vec<i64>, blocks Vec<i64>, count i32) {
    add_incoming(phi, vec_data_i64(values), vec_data_i64(blocks), count)
}

pub fn verify_module(mod *byte) bool {
    message: string := none
    ok := verify_module_raw(mod, 2, &message) == 0
    if message != none {
        if !ok { c_puts(message) }
        dispose_message(message)
    }
    return ok
}

pub fn write_module(mod *byte, path string) bool {
    message: string := none
    ok := module_to_file_raw(mod, path, &message) == 0
    if message != none { dispose_message(message) }
    return ok
}

pub fn block_has_terminator(builder *byte) bool {
    block := insert_block(builder)
    return block != none && block_terminator(block) != none
}

pub fn int_eq() i32 { return 32 }
pub fn int_ne() i32 { return 33 }
pub fn int_sgt() i32 { return 38 }
pub fn int_sge() i32 { return 39 }
pub fn int_slt() i32 { return 40 }
pub fn int_sle() i32 { return 41 }
