{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YCPL project",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Project name." },
    "version": { "type": "string", "description": "Project version." },
    "entry": { "type": "string", "default": "src/main.yc", "description": "Entry source relative to this project." },
    "src": { "type": "array", "items": { "type": "string" }, "default": ["src/"], "description": "Source directories scanned recursively." },
    "output": { "type": "string", "default": "build/", "description": "Compiler output directory." }
  }
}
